# Supabase (https://supabase.com → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
# Use the test site key below for local development (always passes):
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Admin e-mail (used to restrict access to /admin)
ADMIN_EMAIL=admin@example.com

# Demo / preview mode — set to "true" to skip Turnstile loading and API submission.
# This lets you walk through all survey steps and see the layout without any
# external services. Never set this to "true" in production.
NEXT_PUBLIC_DEMO_MODE=true
